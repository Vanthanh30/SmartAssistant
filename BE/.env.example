# ENV-NOTE: Khong commit .env. Cac gia tri hien co duoc giu nguyen; chi field con thieu duoc bo sung.
# ENV-NOTE: Co the giu development khi chay local. Production yeu cau CORS_ORIGIN HTTPS.
NODE_ENV=development
# ENV-NOTE: Cong Node API; mac dinh 4000. Dong bo VITE_API_BASE_URL neu doi cong.
PORT=4000
# ENV-NOTE: CAN CUNG CAP: origin frontend thuc te, local http://localhost:5173; khong path hoac dau / cuoi.
CORS_ORIGIN=http://localhost:5173
# ENV-NOTE: CAN CUNG CAP: dia chi MySQL; local thuong 127.0.0.1.
DB_HOST=127.0.0.1
# ENV-NOTE: CAN CUNG CAP neu MySQL khac cong mac dinh 3306.
DB_PORT=3306
# ENV-NOTE: CAN CUNG CAP: tai khoan MySQL co quyen truy cap database ung dung va chay migrations.
DB_USER=study_app
# ENV-NOTE: CAN CUNG CAP: mat khau MySQL thuc te, khong de replace_me. Dat trong dau nhay neu co ky tu #.
DB_PASSWORD=
# ENV-NOTE: CAN CUNG CAP: ten database MySQL da tao; chi chu, so va dau gach duoi.
DB_NAME=study_assistant
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
SESSION_COOKIE_NAME=study_session
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
SESSION_TTL_SECONDS=86400
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
AUTH_RATE_LIMIT_PER_15_MINUTES=20
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
BCRYPT_ROUNDS=12
# ENV-NOTE: Co the giu mac dinh; duong dan relative tinh tu BE, thu muc can quyen ghi.
AVATAR_DIR=./storage/avatars
# Only for explicit admin seed. Never sent to FE.
# ENV-NOTE: CHI CAN KHI SEED ADMIN: email admin chua ton tai; npm run db:seed khong doi role tai khoan cu.
ADMIN_EMAIL=
# ENV-NOTE: CHI CAN KHI SEED ADMIN: ho ten admin, 2-100 ky tu.
ADMIN_FULL_NAME=
# ENV-NOTE: CHI CAN KHI SEED ADMIN: mat khau admin 8-72 byte UTF-8; khong gui sang FE.
ADMIN_PASSWORD=

# Internal runtime launcher; never expose these as VITE_*
# ENV-NOTE: Cong Python noi bo, mac dinh 8001; phai khac PORT cua Node API.
RAG_PORT=8001
# ENV-NOTE: CAN CUNG CAP: chuoi bi mat ngau nhien >=32 ky tu, khong bat dau replace_; GIONG BE/rag-service/.env.
RAG_SERVICE_TOKEN=replace_with_same_random_secret_at_least_32_chars
# PYTHON_BIN may point to your virtualenv Python executable

# Sprint04: private PDF storage and bounded extraction jobs
# ENV-NOTE: Co the giu mac dinh; PDF private, duong dan relative tinh tu BE, thu muc can quyen ghi.
UPLOAD_DIR=./storage/uploads
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
MAX_UPLOAD_MB=20
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
MAX_DOCUMENTS_PER_COURSE=50
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
MAX_COURSE_STORAGE_MB=500
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
MAX_USER_STORAGE_MB=1024
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
PDF_MAX_PAGES=1000
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
PDF_MAX_TEXT_CHARS=5000000
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
PDF_EXTRACTION_TIMEOUT_MS=60000
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
JOB_POLL_MS=1000
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
JOB_LEASE_SECONDS=30
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
JOB_MAX_ATTEMPTS=3
# ENV-NOTE: URL Python noi bo: http://127.0.0.1:8001, dong bo RAG_PORT; code chi chap nhan loopback khong path.
RAG_SERVICE_URL=http://127.0.0.1:8001
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
RAG_TIMEOUT_MS=300000
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
RECONCILIATION_INTERVAL_MS=300000
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
ORPHAN_GRACE_SECONDS=86400
 
# F07: backend-only provider credentials. Configure an available Responses/JSON-schema model.
# ENV-NOTE: Giu openai; code hien tai chi ho tro provider nay.
LLM_PROVIDER=openai
# ENV-NOTE: CAN CUNG CAP DE DUNG AI: ID model tai khoan duoc truy cap, ho tro Responses va JSON schema strict.
LLM_MODEL=
# ENV-NOTE: CAN CUNG CAP DE DUNG AI: API key thuc te co quyen goi model va han muc; chi luu o BE.
OPENAI_API_KEY=
# Actual context window of the configured model; 0 leaves grounded LLM calls unconfigured.
# Example: LLM_MODEL=gpt-4o-mini requires LLM_MODEL_CONTEXT_TOKENS=128000.
# ENV-NOTE: CAN CUNG CAP DE DUNG AI: context window dung cua model, so nguyen >0; 0 se bao503. Can du input + output reserve.
LLM_MODEL_CONTEXT_TOKENS=0
# Leave blank when the model does not support temperature; otherwise e.g.0.1.
# ENV-NOTE: TUY CHON: de trong neu model khong ho tro; neu ho tro thi gia tri 0-2.
LLM_TEMPERATURE=
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
LLM_TIMEOUT_MS=60000
# ENV-NOTE: Co the giu 1500; gioi han output hoi dap, khong phai output quiz/flashcard.
LLM_MAX_OUTPUT_TOKENS=1500
# ENV-NOTE: Co the giu 6000; tong input tinh ca prompt/schema/nguon. Phai du context window cho input + output.
LLM_CONTEXT_BUDGET_TOKENS=6000
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
ASK_MAX_QUESTION_CHARS=1000
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
ASK_RATE_LIMIT_PER_MINUTE=10
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
ASK_DAILY_LIMIT=100
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
RAG_TOP_K=5
# ENV-NOTE: Co the giu gia tri mac dinh tu .env.example; chi doi khi can dieu chinh runtime/han muc.
RAG_SCORE_THRESHOLD=0.75

# Quiz/flashcard generation: local rules, no LLM/API key; daily UTC quota.
# ENV-NOTE: Co the giu 20; han muc reserve tao bo hoc/user/ngay UTC. Luot loi da reserve van tinh, xoa bo khong hoan quota.
LEARNING_DAILY_LIMIT=20

# ENV-NOTE: TUY CHON PYTHON_BIN: duong dan Python virtualenv neu launcher khong tim thay; chi bo comment khi dien duong dan that.
# PYTHON_BIN=E:/k1-2027/StudyAssistant/.venv/Scripts/python.exe

# Cloudinary: provide all 3 to enable private cloud storage for new PDF/avatar uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP: provide HOST/USER/PASSWORD/FROM together; 465 usually secure=true, 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Cloud-only media: Cloudinary credentials are REQUIRED for new PDF/avatar uploads.
# Existing UPLOAD_DIR/AVATAR_DIR values identify legacy copies for cleanup only.
# New media reads/uploads/extraction use bounded RAM; no local media fallback.
# INDEX_ROOT/VECTOR_ROOT in rag-service/.env remain local for FAISS rebuild/delete/recovery.
# Migrate through014 before restarting API/worker; document extraction payloads live in MySQL.
