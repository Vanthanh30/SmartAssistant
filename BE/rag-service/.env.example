# ENV-NOTE: Khong commit .env. Cac gia tri hien co duoc giu nguyen; chi field con thieu duoc bo sung.
# ENV-NOTE: Giu 127.0.0.1; code chi cho service noi bo bind loopback.
HOST=127.0.0.1
# ENV-NOTE: Giu 8001; dong bo BE RAG_PORT/RAG_SERVICE_URL. Launcher uu tien RAG_PORT tu BE.
PORT=8001
# ENV-NOTE: CAN CUNG CAP: cung chuoi bi mat >=32 ky tu voi BE/.env; khong bat dau replace_.
RAG_SERVICE_TOKEN=replace_with_same_random_secret_at_least_32_chars
# ENV-NOTE: Co the giu intfloat/multilingual-e5-base; can tai model/cache va dependencies ST/FAISS.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# ENV-NOTE: Co the giu commit40hex hien co. Neu doi model, cung cap commit40hex dung cua model va rebuild index.
EMBEDDING_REVISION=d128750597153bb5987e10b1c3493a34e5a4502a
# ENV-NOTE: Ghi chu: pipeline hien tai tu gan prefix query: cho E5; config.py khong doc bien nay.
EMBEDDING_QUERY_PREFIX=query: 
# ENV-NOTE: Ghi chu: pipeline hien tai tu gan prefix passage: cho E5; config.py khong doc bien nay.
EMBEDDING_PASSAGE_PREFIX=passage: 
# ENV-NOTE: Co the giu ../storage/indexes; relative tu BE/rag-service, can quyen ghi.
INDEX_ROOT=../storage/indexes
# ENV-NOTE: Co the giu ../storage/vectors; relative tu BE/rag-service, can quyen ghi.
VECTOR_ROOT=../storage/vectors
# ENV-NOTE: Co the giu 700; khoang cho phep100-1000. Doi cau hinh can rebuild nguon/index.
RAG_PARENT_CHUNK_TOKENS=700
# ENV-NOTE: Co the giu 0.15; khoang cho phep0.1-0.2.
RAG_CHUNK_OVERLAP=0.15
